#!/usr/bin/env bash
# pre-merge-commit — той самий дрейф паспортів, що й у pre-commit.
#
# Рев-ю 6b, H2: `git merge` НЕ запускає pre-commit, для нього є окремий хук
# (git ≥ 2.24). Відтворено: мерж гілки з вилученим якорем проходив мовчки.
# Для цього репо це не академічно — історія strw-factory не лінійна
# (`d58b8b9 Merge branch 'brain-v1'`).
#
# МЕЖА, названа чесно, а не закрита виглядом покриття: `cherry-pick`, `rebase`
# і `revert` не запускають ЖОДНОГО pre-commit-хука за побудовою. Їх цей
# механізм не покриває і покрити не може. Останній рубіж для них — кореневий
# набір `tests/run.sh`, який ганяється руками або в чужому циклі.
set -uo pipefail
bash "$(dirname "$0")/_drift-check.sh" || exit 1
