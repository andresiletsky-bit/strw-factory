#!/usr/bin/env bash
# strw-factory pre-commit. Активація (разово): git config core.hooksPath .githooks
#
# Дві перевірки, обидві спільними скриптами з strw-ops (логіка одна на всі
# репо, копії розійшлись би). Відсутність скрипта — FAIL, не пропуск: гейт, що
# мовчки зникає, гірший за відсутній.
#
#   1. гейт розміру конституції;
#   2. дрейф паспортів — правило, вилучене з loops/, мусить червоніти В МОМЕНТ
#      ВИЛУЧЕННЯ. Рев-ю 6b, F3: пін жив у strw-ops і стеріг файл ТУТ, а ніщо
#      його не викликало — коміт, що видаляє правило, проходив зелено, і
#      червоне зʼявилось би лише при випадковому ручному прогоні тижнями
#      пізніше. Гвардія, що не доїжджає до акту, який стереже, — той самий
#      клас, що правило, яке не доїжджає до сесій.
set -uo pipefail
GATE="${STRW_ROOT:-$HOME/Developer/STRW}/bin/constitution-size-gate.sh"
if [ ! -f "$GATE" ]; then
  echo "pre-commit FAIL: немає $GATE — гейт розміру конституції недоступний."
  echo "  Понови strw-ops (~/Developer/STRW) або постав STRW_ROOT."
  exit 1
fi
bash "$GATE" || exit 1

# Дрейф паспортів перевіряється лише коли коміт ЇХ чіпає — інакше кожен коміт
# у цьому репо платив би за прогін чужого набору.
if git diff --cached --name-only | grep -q '^loops/'; then
  DRIFT="${STRW_ROOT:-$HOME/Developer/STRW}/tests/integration/docs-current.test.sh"
  if [ ! -f "$DRIFT" ]; then
    echo "pre-commit FAIL: немає $DRIFT — перевірка дрейфу паспортів недоступна,"
    echo "  а коміт чіпає loops/. Понови strw-ops або постав STRW_ROOT."
    exit 1
  fi
  bash "$DRIFT" >/dev/null 2>&1 || {
    echo "pre-commit FAIL: дрейф паспортів. Прожени й подивись, що саме:"
    echo "  bash $DRIFT"
    exit 1
  }
fi
